{
  "name": "@nugehs/repoctx",
  "version": "1.4.3",
  "mcpName": "io.github.nugehs/repoctx",
  "description": "repoctx: local repo discovery, indexing, catalog search, and agent harnesses.",
  "type": "module",
  "bin": {
    "repoctx": "src/cli.js",
    "dev-context": "src/cli.js"
  },
  "files": [
    "assets",
    "src",
    "scripts",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "scripts": {
    "start": "node src/cli.js",
    "mcp": "node src/cli.js mcp",
    "doctor": "node src/cli.js doctor",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "version:check": "node scripts/check-version.js",
    "version": "node scripts/sync-server-version.mjs && git add server.json",
    "test": "node --test tests/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**/*.js\" --test-coverage-lines=70 --test-coverage-branches=60 --test-coverage-functions=75 tests/*.test.js",
    "audit": "npm audit --omit=dev",
    "smoke": "node src/cli.js doctor && node src/cli.js harness . --json && npm run smoke:tarball",
    "quality": "npm run format:check && npm run lint && npm run typecheck && npm run version:check && npm test && npm run test:coverage && npm run audit && npm run smoke",
    "ci": "npm run quality",
    "prepublishOnly": "npm run ci",
    "smoke:tarball": "node scripts/smoke-tarball.mjs"
  },
  "engines": {
    "node": ">=18.18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nugehs/repoctx.git"
  },
  "homepage": "https://nugehs.github.io/repoctx/",
  "bugs": {
    "url": "https://github.com/nugehs/repoctx/issues"
  },
  "keywords": [
    "cli",
    "mcp",
    "mcp-server",
    "code-context",
    "code-map",
    "agent",
    "pr-review",
    "merge-gate",
    "repository-analysis",
    "developer-tools"
  ],
  "license": "MIT",
  "dependencies": {
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^10.4.0",
    "prettier": "^3.8.3"
  }
}
