{
  "name": "dev-context",
  "version": "0.2.0",
  "description": "repoctx: local repo discovery, indexing, catalog search, and agent harnesses.",
  "type": "module",
  "bin": {
    "repoctx": "./src/cli.js",
    "dev-context": "./src/cli.js"
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "start": "node src/cli.js",
    "mcp": "node src/cli.js mcp",
    "test": "node --test tests/*.test.js",
    "smoke": "node src/cli.js doctor && node src/cli.js harness . --json"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nugehs/dev-context.git"
  },
  "license": "MIT",
  "dependencies": {
    "typescript": "^5.9.3"
  }
}
